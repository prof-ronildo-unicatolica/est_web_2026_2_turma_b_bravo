# =============================================================================
#  .env.exemplo — Variáveis de Ambiente do Projeto StayFlow
#  INSTRUÇÕES: Copie este arquivo para ".env" e preencha os valores reais.
#              O arquivo ".env" NUNCA deve ser comitado no repositório Git.
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=TROQUE_PARA_UMA_SENHA_SEGURA
POSTGRES_DB=hotel_db_dev
POSTGRES_PORT=5432

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Formato: mongodb://<usuario>:<senha>@<host>:<porta>
# Em ambiente Docker, use "mongodb" como host (nome do serviço no compose).
MONGODB_URL=mongodb://admin:TROQUE_PARA_UMA_SENHA_SEGURA@localhost:27017
MONGODB_DB=hotel_mongo_dev

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:TROQUE_PARA_UMA_SENHA_SEGURA@localhost:5672/

# ─── JWT / Autenticação ──────────────────────────────────────────────────────
# Gere um valor seguro com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=TROQUE_PARA_UMA_CHAVE_ALEATORIA_E_LONGA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
